{
  "name": "Document",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "case_title": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "lawyer_id": {
      "type": "string"
    },
    "senior_lawyer_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "contract",
        "evidence",
        "filing",
        "court_order",
        "id_proof",
        "other"
      ],
      "default": "other"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "title",
    "file_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.lawyer_id": "{{user.id}}"
        },
        {
          "data.senior_lawyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}