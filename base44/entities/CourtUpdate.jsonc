{
  "name": "CourtUpdate",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "case_title": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "lawyer_id": {
      "type": "string"
    },
    "senior_lawyer_id": {
      "type": "string"
    },
    "hearing_date": {
      "type": "string",
      "format": "date"
    },
    "judge": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "next_hearing_date": {
      "type": "string",
      "format": "date"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "scheduled",
        "adjourned",
        "completed",
        "order_passed",
        "other"
      ],
      "default": "scheduled"
    }
  },
  "required": [
    "case_id",
    "hearing_date",
    "summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.lawyer_id": "{{user.id}}"
        },
        {
          "data.senior_lawyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.lawyer_id": "{{user.id}}"
        },
        {
          "data.senior_lawyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}