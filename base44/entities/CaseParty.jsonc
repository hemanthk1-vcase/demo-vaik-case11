{
  "name": "CaseParty",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "party_role": {
      "type": "string",
      "enum": [
        "petitioner",
        "respondent",
        "co_petitioner",
        "co_defendant",
        "intervenor",
        "guardian_ad_litem",
        "witness",
        "opposing_counsel"
      ]
    },
    "is_primary_contact": {
      "type": "boolean",
      "default": false
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "lawyer_id": {
      "type": "string"
    },
    "senior_lawyer_id": {
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "full_name",
    "party_role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.lawyer_id": "{{user.id}}"
        },
        {
          "data.senior_lawyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.lawyer_id": "{{user.id}}"
        },
        {
          "data.senior_lawyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.lawyer_id": "{{user.id}}"
        },
        {
          "data.senior_lawyer_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}