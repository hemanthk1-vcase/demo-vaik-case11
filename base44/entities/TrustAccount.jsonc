{
  "name": "TrustAccount",
  "type": "object",
  "properties": {
    "account_name": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "trust",
        "operating"
      ],
      "default": "trust"
    },
    "currency": {
      "type": "string",
      "enum": [
        "INR"
      ],
      "default": "INR"
    },
    "current_balance": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "account_name",
    "account_number",
    "bank_name",
    "account_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}